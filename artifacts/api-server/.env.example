# Example only. Never commit real values. Server-side only: never prefix with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Sites allowed to call the API from a browser with the admin cookie
# (comma-separated, exact origins). Same-origin requests need nothing here.
CORS_ORIGINS=http://localhost:5173

# Only when running behind a real reverse proxy / host load balancer:
# number of proxy hops to trust for the client IP (rate limiting uses it).
# Leave unset otherwise, or clients could fake their IP.
# TRUST_PROXY=1

# Optional: admin session idle timeout in hours (default 12; max age is 7 days).
# ADMIN_SESSION_IDLE_HOURS=12

# Optional: force the Secure cookie flag outside production (e.g. local HTTPS).
# COOKIE_SECURE=true
